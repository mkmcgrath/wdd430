{
  "name": "knowledge-vault",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"astro dev\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build": "astro build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=.env dist-server/index.mjs",
    "preview": "npm run build && SERVE_STATIC=1 npm run start",
    "test": "vitest run",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22.23"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@hono/node-server": "^2.1.5",
    "astro": "^7.4.4",
    "hono": "^4.13.14",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
